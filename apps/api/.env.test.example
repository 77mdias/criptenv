DATABASE_URL=postgresql://criptenv_test:criptenv_test@localhost:55432/criptenv_test
SECRET_KEY=test-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=true
CORS_ORIGINS=http://localhost:3000
SCHEDULER_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORAGE=memory
INTEGRATION_CONFIG_SECRET=test-integration-config-secret-32-chars
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Isolation from the developer .env: pydantic-settings falls back to .env for
# any key missing here, which would leak the real RESEND_API_KEY into E2E and
# make signup fail on example.com fixtures. Empty key disables the email
# service so send-verification exposes the local dev_token instead.
RESEND_API_KEY=
APP_ENV=development
